# متغيرات البيئة في Dokploy (Environment) لخدمة mobil.alrsheed.net — لا ترفع القيم الحقيقية إلى Git.

DJANGO_ENV=production
PORT=7081

# مفتاح سري جديد خاص بالموبايل (50+ حرفًا). لتوليده:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# إن احتوى $ ضعه بين علامتي اقتباس مفردة.
SECRET_KEY=

# قاعدة بيانات الموقع نفسها (MySQL على Hostinger) — انسخ القيمة من متغيرات خدمة الموقع
DATABASE_URL=

# النطاق العام للخدمة
ALLOWED_HOSTS=mobil.alrsheed.net,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://mobil.alrsheed.net
MOBILE_API_ALLOWED_HOSTS=mobil.alrsheed.net

TIME_ZONE=Asia/Riyadh

# اختياري
# GUNICORN_WORKERS=1          # أكثر من 1 يتطلب REDIS_URL لضبط قفل الدخول بدقة
# GUNICORN_THREADS=8
# REDIS_URL=redis://...
# MOBILE_TOKEN_TTL_HOURS=168
# MOBILE_LOGIN_MAX_FAILURES=5
# MOBILE_LOGIN_LOCK_MINUTES=15
